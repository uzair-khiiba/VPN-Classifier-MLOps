# Copy this file to .env to change where the dashboard looks for the API. .env is git-ignored.
# A real API_BASE_URL environment variable takes priority over this file.
API_BASE_URL=http://127.0.0.1:8000

# Where experiments log. This project doesn't load these from .env: set them in your terminal first.
# Never put a token in this file or in the repository. Use `dagshub login`, which stores it outside the project.
#   EXPERIMENT_TRACKING        local (default) or dagshub, for the experiments/ scripts
#   DAGSHUB_MAIN_EXPERIMENT    the name used on DagsHub for zainab_experiments (default: zainab_experiments_history)
#   MLFLOW_TRACKING_URI        where src.train and src.automl_ludwig log (default: sqlite:///mlflow.db)
#   MLFLOW_EXPERIMENT          the experiment they log to (default: vpn-proxy-classification)
